# Base de datos PostgreSQL
# En Railway: copia el valor de DATABASE_URL que provee el plugin de Postgres
DATABASE_URL=postgresql://usuario:password@host:5432/reordena_abc

# Clave secreta para firmar JWT — genera una con: openssl rand -hex 32
SECRET_KEY=reemplaza-con-clave-secreta-segura

# Orígenes permitidos para CORS (separa múltiples con coma, sin espacios)
# En producción: coloca la URL exacta de tu frontend en Vercel
ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

# Credenciales del usuario administrador inicial (usadas en crear_admin.py)
ADMIN_EMAIL=admin@reordena.com
ADMIN_PASSWORD=CambiaEstaContrasena2024!
